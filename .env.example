# Copy to .env and edit before running `docker compose up -d --build`.

# Web login, format user:pass. Required by docker-compose.yaml.
WEBSSH_AUTH_INFO=admin:change-me-to-a-long-random-password

# Port published on the host.
WEBSSH_PORT=5032

# Optional URL prefix when served behind a reverse proxy, e.g. /webssh
WEBSSH_BASE_PATH=

# Allow saving SSH passwords in the profile store (true/false).
WEBSSH_SAVE_PASS=true

# Encrypt saved SSH profiles at rest. Strongly recommended when SAVE_PASS=true.
# Generate one with: openssl rand -hex 32
WEBSSH_SECRET_KEY=

# Verify SSH host keys against a known_hosts file (true/false).
WEBSSH_STRICT_HOST_KEY=false

TZ=Asia/Shanghai
